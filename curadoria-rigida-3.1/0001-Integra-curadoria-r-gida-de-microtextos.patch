+      ],
+      "tone": "ironico",
+      "editorialTone": "íntimo e irônico",
+      "attributionLabel": "texto editorial"
+    },
+    {
+      "id": "TXT-INS-003",
+      "title": "Casas sobre palafitas",
+      "finalText": "Minhas certezas se erguem sobre palafitas. Por fora, a casa parece pronta: opinião firme, resposta rápida, passos seguros. Por baixo, porém, qualquer dúvida faz o chão tremer. Talvez por isso eu defenda algumas ideias com força demais. Nem sempre é convicção; às vezes é medo de descobrir que não há terra sob os pés. A insegurança pode vestir a roupa da certeza e falar com voz de autoridade. Quanto mais frágil a base, maior a necessidade de impedir que alguém bata à porta.",
+      "displayType": "microtexto",
+      "attributionType": "editorial",
+      "author": "Entre Sábios",
+      "displayedAuthor": "Entre Sábios",
+      "inspirationSource": null,
+      "sourceNote": "Texto editorial criado para o projeto Entre Sábios, 2026",
+      "primaryFeeling": "inseguranca",
+      "secondaryFeelings": [
