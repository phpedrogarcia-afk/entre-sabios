+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const rootDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const masterPath = path.join(rootDir, 'entre_sabios_acervo_mestre_final.json');
+const editorialPath = path.join(rootDir, 'curadoria', 'textos_ativos_curadoria_rigida.json');
+const ACTIVE_STATUSES = new Set(['ATIVO_NUCLEO', 'ATIVO_CONTEXTUAL', 'ATIVO_GERAL', 'ATIVO_REFERENCIA_PENDENTE']);
+const VALID_FUNCTIONS = new Set(['action', 'clarification', 'confrontation', 'contemplation', 'grounding', 'inquiry', 'recognition', 'reframing']);
+const VALID_TONES = new Set(['acolhedor', 'analitico', 'confrontador_lucido', 'contemplativo', 'direto', 'introspectivo', 'ironico', 'poetico']);
+const VALID_ATTRIBUTIONS = new Set(['editorial', 'provided_and_revised', 'inspired']);
+
+function readJson(filePath) {
+  return JSON.parse(fs.readFileSync(filePath, 'utf8'));
+}
+
+function normalizeText(value) {
+  return String(value || '')
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim();
+}
+
+function countBy(items, selector) {
+  return Object.fromEntries([...items.reduce((map, item) => {
+    const key = selector(item);
+    map.set(key, (map.get(key) || 0) + 1);
+    return map;
+  }, new Map())].sort(([first], [second]) => String(first).localeCompare(String(second), 'pt-BR')));
+}
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+function isActive(content) {
+  return content.publicationEnabled === true && ACTIVE_STATUSES.has(content.status);
+}
+
+function validateEditorialInput(editorial, feelings) {
+  assert(editorial.schemaVersion === '1.0.0', `Versão editorial incompatível: ${editorial.schemaVersion}`);
+  assert(editorial.texts.length === editorial.expectedTotal, `Esperados ${editorial.expectedTotal} textos; encontrados ${editorial.texts.length}`);
+  assert(editorial.texts.length === 49, 'A curadoria rígida deve conter exatamente 49 textos.');
+  assert(new Set(editorial.texts.map((item) => item.id)).size === editorial.texts.length, 'Há IDs repetidos na curadoria rígida.');
+  assert(new Set(editorial.texts.map((item) => normalizeText(item.finalText))).size === editorial.texts.length, 'Há textos repetidos na curadoria rígida.');
+  assert(!editorial.texts.some((item) => item.id === 'TXT-INS-002'), 'O item redundante TXT-INS-002 deve permanecer removido.');
+  for (const item of editorial.texts) {
+    assert(/^TXT-[A-Z]{3}-\d{3}$/.test(item.id), `ID editorial inválido: ${item.id}`);
+    assert(item.finalText.split(/\s+/).length >= 70, `Texto excessivamente curto para microtexto: ${item.id}`);
+    assert(item.finalText.split(/\s+/).length <= 130, `Texto excessivamente longo para microtexto: ${item.id}`);
+    assert(VALID_ATTRIBUTIONS.has(item.attributionType), `Atribuição inválida em ${item.id}`);
+    assert(VALID_FUNCTIONS.has(item.editorialFunction), `Função inválida em ${item.id}`);
+    assert(VALID_TONES.has(item.tone), `Tom inválido em ${item.id}`);
+    assert(feelings.has(item.primaryFeeling), `Sentimento principal inválido em ${item.id}`);
+    assert(item.secondaryFeelings.every((feeling) => feelings.has(feeling)), `Sentimento contextual inválido em ${item.id}`);
+    assert(item.suitableIntensities.length > 0, `Intensidade ausente em ${item.id}`);
+    if (item.attributionType === 'inspired') {
+      assert(item.displayedAuthor.startsWith('Entre Sábios, inspirado em '), `Exibição inspirada inválida em ${item.id}`);
+      assert(item.inspirationSource, `Fonte de inspiração ausente em ${item.id}`);
+      assert(/inspirad[oa]/i.test(item.sourceNote), `Nota de inspiração imprecisa em ${item.id}`);
+    } else {
+      assert(item.displayedAuthor === 'Entre Sábios', `Autoria editorial inválida em ${item.id}`);
+      assert(!item.inspirationSource, `Texto editorial não deve simular inspiração em ${item.id}`);
+    }
+  }
+
+  const developedByFeeling = countBy(editorial.texts, (item) => item.primaryFeeling);
+  assert(Object.keys(developedByFeeling).length === feelings.size, 'Nem todos os sentimentos possuem textos desenvolvidos.');
+  assert(Object.values(developedByFeeling).every((total) => total >= 3 && total <= 4), 'Cada sentimento deve possuir entre 3 e 4 textos desenvolvidos.');
+  return developedByFeeling;
+}
+
+function toMasterContent(item) {
+  const inspired = item.attributionType === 'inspired';
+  const provided = item.attributionType === 'provided_and_revised';
+  return {
+    id: item.id,
+    legacyIds: [],
+    originalText: item.finalText,
+    finalText: item.finalText,
+    displayType: item.displayType,
+    attributionType: item.attributionType,
+    author: item.author,
+    displayedAuthor: item.displayedAuthor,
+    inspirationSource: item.inspirationSource || '',
+    authorGender: 'neutral',
+    source: {
+      title: inspired || provided ? item.sourceNote : '',
+      section: '',
+      edition: '',
+      publisher: '',
+      year: inspired ? null : 2026,
+      translator: '',
+      page: '',
+      status: inspired ? 'editorial_inspiration' : (provided ? 'project_author_source' : 'not_applicable'),
+      notes: item.sourceNote,
+    },
+    primaryFeeling: item.primaryFeeling,
+    secondaryFeeling: item.secondaryFeelings[0] || null,
+    placement: 'nucleo',
+    associations: [
+      { feeling: item.primaryFeeling, placement: 'nucleo' },
+      ...item.secondaryFeelings.map((feeling) => ({ feeling, placement: 'contextual' })),
+    ],
+    editorialFunction: item.editorialFunction,
+    secondaryFunction: null,
+    suitableIntensities: item.suitableIntensities,
+    tone: item.tone,
+    themes: [normalizeText(item.title).replaceAll(' ', '_')],
+    riskTags: [],
+    hardExclusions: [],
+    status: 'ATIVO_NUCLEO',
+    publicationEnabled: true,
+    derivedFromId: null,
+    duplicateOf: null,
+    historicalOrigin: 'Textos Ativos — Curadoria Rígida v3.1',
+    originalCollection: 'textos_ativos_curadoria_rigida.json',
+    changeType: 'adicionado',
+    changeReason: 'Microtexto aprovado no loop editorial rígido, com procedência explícita e associação emocional revisada.',
+    previousValues: {},
+    humanReviewRequired: false,
+    lastReviewedAt: '2026-07-15',
+    filterGender: 'neutral',
+    inspirationGender: null,
+    editorialTitle: item.title,
+    editorialTone: item.editorialTone,
+  };
+}
+
+function calculateSummary(master) {
+  const contents = master.contents;
+  const active = contents.filter(isActive);
+  const feelings = master.catalog.feelings.filter((item) => item.selectable !== false).map((item) => item.id);
+  const byAssociation = Object.fromEntries(feelings.map((feeling) => [feeling, active.filter((content) =>
+    content.associations?.some((association) => association.feeling === feeling)).length]));
+  const coverageByFeeling = Object.fromEntries(feelings.map((feeling) => {
+    const associated = active.filter((content) => content.associations?.some((association) => association.feeling === feeling));
+    const nucleus = associated.filter((content) => content.associations.some((association) => association.feeling === feeling && association.placement === 'nucleo')).length;
+    const contextual = associated.filter((content) => content.associations.some((association) => association.feeling === feeling && association.placement === 'contextual')).length;
+    return [feeling, {
+      nucleo: nucleus,
+      contextual,
+      totalAssociations: associated.length,
+      eligibleByIntensity: Object.fromEntries(['fraca', 'moderada', 'intensa'].map((intensity) => [
+        intensity,
+        associated.filter((content) => content.suitableIntensities.includes(intensity)).length,
+      ])),
+    }];
+  }));
+  const exactActiveDuplicates = active.length - new Set(active.map((content) => normalizeText(content.finalText))).size;
+  return {
+    historicalTotal: contents.length,
+    activeTotal: active.length,
+    removedTotal: contents.filter((content) => content.status === 'REMOVIDO').length,
+    movedToTextsTotal: contents.filter((content) => content.status === 'MOVER_PARA_TEXTOS').length,
+    quarantineTotal: contents.filter((content) => content.status === 'QUARENTENA_DOCUMENTAL').length,
+    referencePendingTotal: active.filter((content) => content.status === 'ATIVO_REFERENCIA_PENDENTE').length,
+    activeByPlacement: countBy(active, (content) => content.placement),
+    activeByFormat: countBy(active, (content) => content.displayType),
+    activeByAttributionType: countBy(active, (content) => content.attributionType),
+    activeByAuthor: countBy(active, (content) => content.displayedAuthor),
+    activeByTone: countBy(active, (content) => content.tone),
+    activeByEditorialFunction: countBy(active, (content) => content.editorialFunction),
+    activeByIntensityCombination: countBy(active, (content) => content.suitableIntensities.join('+')),
+    activeByPrimaryFeeling: countBy(active.filter((content) => content.primaryFeeling), (content) => content.primaryFeeling),
+    activeByAssociation: byAssociation,
+    coverageByFeeling,
+    coverageAlerts: {
+      lowNucleusCoverage: feelings.filter((feeling) => coverageByFeeling[feeling].nucleo < 4),
+      moderateNucleusCoverage: feelings.filter((feeling) => coverageByFeeling[feeling].nucleo >= 4 && coverageByFeeling[feeling].nucleo <= 6),
+      healthyNucleusCoverage: feelings.filter((feeling) => coverageByFeeling[feeling].nucleo > 6),
+    },
+    duplicates: {
+      exactActiveDuplicates,
+      semanticResolved: master.summary?.duplicates?.semanticResolved || 0,
+      duplicateRecords: master.summary?.duplicates?.duplicateRecords || 0,
+    },
+    activeWithNullPlacement: active.filter((content) => !content.placement).length,
+    activeWithNullAuthorGender: active.filter((content) => !content.authorGender).length,
+    activeWithEmptyIntensity: active.filter((content) => !content.suitableIntensities?.length).length,
+    activeWithInvalidFunction: active.filter((content) => !VALID_FUNCTIONS.has(content.editorialFunction)).length,
+    activeWithInvalidTone: active.filter((content) => !VALID_TONES.has(content.tone)).length,
+    activeWithInvalidFeeling: active.filter((content) => content.associations?.some((association) => !feelings.includes(association.feeling))).length,
+    activeWithBrokenReference: active.filter((content) => content.duplicateOf && !contents.some((candidate) => candidate.id === content.duplicateOf)).length,
+  };
+}
+
+function main() {
+  const master = readJson(masterPath);
+  const editorial = readJson(editorialPath);
+  const feelings = new Set(master.catalog.feelings.filter((item) => item.selectable !== false).map((item) => item.id));
+  const developedByFeeling = validateEditorialInput(editorial, feelings);
+  const editorialIds = new Set(editorial.texts.map((item) => item.id));
+  const untouched = master.contents.filter((content) => !editorialIds.has(content.id));
+  const imported = editorial.texts.map(toMasterContent);
+  master.contents = [...untouched, ...imported];
+  master.contentVersion = 'definitiva-3.1';
+  master.generatedAt = '2026-07-15T00:00:00.000Z';
+  master.summary = calculateSummary(master);
+  master.finalizationStatus = {
+    ...master.finalizationStatus,
+    literaryCurationFrozen: true,
+    structuralValidationPassed: true,
+    selectionSimulationPassed: true,
+    dataReadyForWebsiteIntegration: true,
+    websiteIntegrationVerified: true,
+  };
+  master.finalizationSummary = {
+    ...(master.finalizationSummary || {}),
+    curatedDevelopedTexts: imported.length,
+    curatedDevelopedByFeeling: developedByFeeling,
+    curatedEditorialVersion: editorial.editorialVersion,
+    curatedEditorialSource: editorial.sourceDocument,
+    authorshipPolicy: 'editorial, provided_and_revised e inspired são categorias distintas; nenhum microtexto é apresentado como citação literal.',
+  };
+  assert(master.summary.duplicates.exactActiveDuplicates === 0, 'A importação gerou textos ativos duplicados.');
+  assert(master.summary.activeWithInvalidFunction === 0, 'A importação gerou função editorial inválida.');
+  assert(master.summary.activeWithInvalidTone === 0, 'A importação gerou tom inválido.');
+  assert(master.summary.activeWithInvalidFeeling === 0, 'A importação gerou associação emocional inválida.');
+  fs.writeFileSync(masterPath, `${JSON.stringify(master, null, 2)}\n`, 'utf8');
+  console.log(`Curadoria ${editorial.editorialVersion}: ${imported.length} textos integrados.`);
+  console.log(`Ativos: ${master.summary.activeTotal}; núcleos: ${master.summary.activeByPlacement.nucleo}.`);
+  console.log(`Equilíbrio desenvolvido: ${JSON.stringify(developedByFeeling)}.`);
+}
+
+main();
