evada"],"hardExclusions":[],"status":"ATIVO_CONTEXTUAL","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Acervo editorial Entre Sábios","status":"not_applicable"}},{"id":"Reflexão contemporânea-2","finalText":"Você nunca saberá ao lado de qual dos meus muitos lados está sentado, mas receberá ao menos um deles quando estivermos juntos.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":null,"secondaryFeeling":null,"associations":[],"placement":"geral","editorialFunction":"contemplation","secondaryFunction":null,"suitableIntensities":["fraca","moderada"],"tone":"contemplativo","themes":[],"riskTags":[],"hardExclusions":[],"status":"ATIVO_GERAL","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Acervo editorial Entre Sábios","status":"not_applicable"}},{"id":"Reflexão contemporânea-4","finalText":"Entre tantos que habitam em mim, um dia talvez eu me descubra. Até lá, ouso conquistar-me.","displayType":"reflexao_curta","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":null,"secondaryFeeling":null,"associations":[],"placement":"geral","editorialFunction":"reframing","secondaryFunction":"contemplation","suitableIntensities":["fraca","moderada"],"tone":"direto","themes":[],"riskTags":[],"hardExclusions":[],"status":"ATIVO_GERAL","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Acervo editorial Entre Sábios","status":"not_applicable"}},{"id":"Rumi-2","finalText":"Quando você age de acordo com aquilo que valoriza, torna-se mais capaz de reconhecer oportunidades compatíveis com sua busca.","displayType":"frase","attributionType":"inspired","author":"Entre Sábios","displayedAuthor":"Entre Sábios, inspirado em Rumi","inspirationSource":"Rumi","primaryFeeling":"falta_de_proposito","secondaryFeeling":null,"associations":[{"feeling":"falta_de_pr