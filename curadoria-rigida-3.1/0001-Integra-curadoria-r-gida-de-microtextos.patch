"confusao","secondaryFeeling":null,"associations":[{"feeling":"confusao","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":"clarification","suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["confusao","conflito interno"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-CON-003","finalText":"Defendo uma ideia e, no minuto seguinte, já não sei se acredito nela.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"confusao","secondaryFeeling":null,"associations":[{"feeling":"confusao","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":"clarification","suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["confusao","contradição","dúvida"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-001","finalText":"Minhas certezas se erguem sobre palafitas; qualquer dúvida faz o chão tremer.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"poetico","themes":["inseguranca","dúvida"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-002","finalText":"Há um comitê dentro de mim que me reprova antes mesmo de eu tentar.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["inseguranca","crítica interna"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-003","finalText":"Sinto-me um impostor na minha própria vida, esperando que alguém descubra que estou improvisando.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["inseguranca","impostor","incompetência percebida"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-004","finalText":"Um elogio me sustenta por horas; uma crítica me afunda por dias.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["inseguranca","necessidade de aprovação"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-005","finalText":"A insegurança é uma plateia invisível que vaia antes mesmo de eu subir ao palco.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"poetico","themes":["inseguranca","medo de julgamento"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-INS-006","finalText":"Toda vez que abro a boca, alguma coisa dentro de mim pergunta se tenho certeza — e quase nunca tenho.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"inseguranca","secondaryFeeling":null,"associations":[{"feeling":"inseguranca","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"introspectivo","themes":["inseguranca","medo de errar"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-LUT-001","finalText":"O luto é o amor que ficou sem endereço.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"luto","secondaryFeeling":null,"associations":[{"feeling":"luto","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"acolhedor","themes":["luto","vínculo","ausência"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-LUT-002","finalText":"Perder alguém é uma amputação invisível: continuamos andando, mas de outro modo.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"luto","secondaryFeeling":null,"associations":[{"feeling":"luto","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"poetico","themes":["luto","perda definitiva","corpo"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-LUT-003","finalText":"O luto não é só a ausência de quem partiu; é a presença de um silêncio novo.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"luto","secondaryFeeling":null,"associations":[{"feeling":"luto","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":"clarification","suitableIntensities":["fraca","moderada","intensa"],"tone":"acolhedor","themes":["luto","ausência","silêncio"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-LUT-004","finalText":"O luto nem sempre é algo que se supera; muitas vezes aprendemos a viver ao redor dele.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"luto","secondaryFeeling":null,"associations":[{"feeling":"luto","placement":"contextual"}],"placement":"contextual","editorialFunction":"clarification","secondaryFunction":null,"suitableIntensities":["moderada","intensa"],"tone":"acolhedor","themes":["luto","continuidade","perda definitiva"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_CONTEXTUAL","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-LUT-005","finalText":"Cada retorno da dor lembra que o vínculo não desapareceu no mesmo instante que a presença.","displayType":"frase","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"luto","secondaryFeeling":null,"associations":[{"feeling":"luto","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"acolhedor","themes":["luto","retorno da dor","vínculo"],"riskTags":[],"hardExclusions":[],"status":"ATIVO_NUCLEO","publicationEnabled":true,"filterGender":"neutral","source":{"title":"Antologia do Silêncio","status":"not_applicable"}},{"id":"ANT-MICRO-PRO-001","finalText":"Acordo sem um “para quê”. Faço as coisas porque precisam ser feitas, mas falta um fio condutor. A vida parece uma colcha de retalhos sem desenho. Sinto falta de um sentido, de uma seta apontando para algum lugar.","displayType":"microtexto","attributionType":"original","author":"Entre Sábios","displayedAuthor":"Entre Sábios","inspirationSource":null,"primaryFeeling":"falta_de_proposito","secondaryFeeling":null,"associations":[{"feeling":"falta_de_proposito","placement":"nucleo"}],"placement":"nucleo","editorialFunction":"recognition","secondaryFunction":null,"suitableIntensities":["fraca","moderada","intensa"],"tone":"